# Release 签名配置模板。
#
# 复制为 keystore.properties（同目录）并填入真实值。
# keystore.properties 与 *.jks 都被 .gitignore 挡住，不会进仓库。
#
# 生成 keystore：
#
#   keytool -genkeypair -v \
#     -keystore magic-sushi-release.jks \
#     -alias magic-sushi \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass <你的密码> -keypass <你的密码> \
#     -dname "CN=Magic Sushi, OU=Development, O=windyvalley, L=Unknown, ST=Unknown, C=CN"
#
# ⚠️ keystore 一旦丢失就无法再为同一个应用发布更新（Android 要求所有更新
#    包的签名一致）。备份 .jks 文件和密码，不要只存在一台机器上。

# .jks 文件路径，相对于 android-app/ 目录
storeFile=magic-sushi-release.jks

# keystore 密码
storePassword=CHANGE_ME

# 密钥别名（keytool -alias 的值）
keyAlias=magic-sushi

# 密钥密码（用 keytool 上面那条命令时与 storePassword 相同）
keyPassword=CHANGE_ME
