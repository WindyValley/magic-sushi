# Android 标准 .gitignore
# 基于 https://github.com/github/gitignore/blob/main/Android.gitignore

# Gradle
.gradle/
build/
local.properties
**/local.properties

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/
.navigation/
captures/

# Keystore
# ⚠️ 签名密钥与密码绝不进仓库。keystore.properties.example 是模板（会提交），
#    keystore.properties 是真实密码（被下面这行挡住）。
*.jks
*.keystore
keystore.properties

# NDK
.cxx/

# Misc
*.log
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# Mac/Linux 临时
.DS_Store
Thumbs.db

# Gradle Wrapper
# gradle-wrapper.jar **要提交** —— 它是 wrapper 的启动器，缺了 ./gradlew 跑不起来。
# （v1.0.0 之前这里曾是个文本占位符，导致 clone 下来无法构建，已换成真 jar。）

# Local config
**/.kotlin/
